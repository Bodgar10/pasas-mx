# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
#
# 🔴 SIN EXCEPCIONES. Aqui hubo un `!.env.test` porque el archivo solo
# tenia price IDs ficticios; despues se le metieron SUPABASE_SERVICE_ROLE_KEY,
# STRIPE_SECRET_KEY y STRIPE_WEBHOOK_SECRET y GitHub bloqueo el push. Ningun
# archivo de entorno se versiona: los valores de prueba se documentan en el
# README o se generan, no se commitean.
.env*

# playwright
/test-results/
/playwright-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# 🔴 EXCEPCIÓN: .env.test SÍ se versiona.
#
# Son seis price IDs ficticios (price_test_grade_monthly y compañía) que la
# capa unitaria necesita para que PRICE_TO_PLAN se construya con seis claves
# distintas en vez de colapsar todas en "undefined". No hay ningún secreto
# dentro, y sin el archivo `npm test` no corre en otra máquina.
!.env.test

# playwright
/test-results/
/playwright-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# =====================================================================
# Variables para la capa unitaria. NINGÚN VALOR ES REAL.
#
# 🔴 POR QUÉ EXISTE ESTE ARCHIVO.
#
# src/lib/payments/config.ts construye PRICE_TO_PLAN y STRIPE_PRICES en el
# momento en que el módulo se importa, leyendo process.env. Sin estas seis
# variables definidas, las claves del Record se vuelven todas la cadena
# "undefined" y COLISIONAN EN UNA SOLA ENTRADA: una prueba de contrato sobre
# esa tabla estaría midiendo un objeto de un elemento y pasaría por razones
# equivocadas.
#
# Los valores son deliberadamente legibles (price_test_<plan>_<ciclo>) para
# que cuando una aserción falle, el diff diga cuál se descuadró.
#
# 🔴 NO PONER SECRETOS AQUÍ. La capa unitaria no habla con Stripe, ni con
# Supabase, ni con Resend: no hay una sola llamada de red en tests/unit.
# STRIPE_SECRET_KEY no está a propósito — ningún módulo bajo prueba importa
# src/lib/payments/stripe.ts, que hace throw al cargarse sin ella.
# =====================================================================

# Planes — los seis pares que llavean PRICE_TO_PLAN.
STRIPE_PRICE_GRADE_MONTHLY_V2=price_test_grade_monthly
STRIPE_PRICE_GRADE_SEMESTRAL=price_test_grade_semestral
STRIPE_PRICE_GRADE_ANNUAL=price_test_grade_annual
STRIPE_PRICE_PERSONALIZADO_MONTHLY_V2=price_test_personalizado_monthly
STRIPE_PRICE_PERSONALIZADO_SEMESTRAL=price_test_personalizado_semestral
STRIPE_PRICE_PERSONALIZADO_ANNUAL=price_test_personalizado_annual

# Asientos — STRIPE_SEAT_PRICES, del mismo archivo. No los llavea ninguna
# tabla, pero se definen para que el objeto no quede con `undefined` dentro.
STRIPE_PRICE_SEAT_MONTHLY=price_test_seat_monthly
STRIPE_PRICE_SEAT_SEMESTRAL=price_test_seat_semestral
STRIPE_PRICE_SEAT_ANNUAL=price_test_seat_annual

# LEGAL_VERSION de src/lib/legal.ts. Se fija para que las aserciones sobre
# `tos_accepted_version` no dependan de lo que tenga Vercel ese día.
NEXT_PUBLIC_TOS_VERSION=1.0-test
